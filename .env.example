# ── LLM & Embeddings (OpenRouter) ──────────────────────────────
OPENROUTER_API_KEY=your-openrouter-key-here
# Free models on OpenRouter:
OPENROUTER_DEFAULT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_FAST_MODEL=liquid/lfm-2.5-2.6b:free
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# ── Relational DB ──────────────────────────────────────────────
# Default (Zero Docker): Local SQLite file database
DATABASE_URL=sqlite+aiosqlite:///./data/personal_intelligence.db
# Alternative (Serverless Cloud / Postgres):
# DATABASE_URL=postgresql+asyncpg://user:password@ep-xyz.neon.tech/dbname

# ── Vector Store (Qdrant) ──────────────────────────────────────
# Default (Zero Docker): Embedded local on-disk storage in ./data/qdrant
QDRANT_PATH=./data/qdrant
# Alternative (Free Cloud): Qdrant Cloud cluster (https://cloud.qdrant.io)
# QDRANT_URL=https://your-cluster-id.us-east-1-0.aws.cloud.qdrant.io:6333
# QDRANT_API_KEY=your-qdrant-api-key

# ── Graph DB (Neo4j) ───────────────────────────────────────────
# Default: If Neo4j is not connected, the retriever gracefully uses Vector + BM25 search.
# Zero-Docker Option: Free Neo4j AuraDB instance (https://neo4j.com/cloud/aura-free)
NEO4J_ENABLED=true
NEO4J_URI=bolt://localhost:7687
# For Neo4j AuraDB:
# NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme123

# ── Optional: Cache / Redis ────────────────────────────────────
# Optional. Free cloud Redis: Upstash (https://upstash.com)
# REDIS_CUSTOM_URL=rediss://default:token@your-upstash-url:6379

# ── Telegram Interface ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# ── API ────────────────────────────────────────────────────────
API_SECRET_KEY=change-me
API_HOST=0.0.0.0
API_PORT=8000
